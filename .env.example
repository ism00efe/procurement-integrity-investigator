# LLM provider configuration (see app/agents/providers).
# The application starts and the deterministic risk engine runs fully without these set;
# only the LLM investigation layer requires a key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Number of highest-risk cases sent to the LLM investigation layer by default.
TOP_N_CASES=20

# Max concurrent LLM calls across all investigators.
LLM_MAX_CONCURRENCY=6

# Per-call timeout (seconds) and retry count for LLM calls.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# DuckDB file location (relative to project root).
DUCKDB_PATH=data/processed/procurement.duckdb
